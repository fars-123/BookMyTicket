
@model BookMyTicket.Models.Admin

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    /* =========================================
       ADMIN DASHBOARD GENERAL
    ========================================= */

    .admin-container {
        width: 94%;
        max-width: 1500px;
        margin: 35px auto;
        color: var(--text-color);
    }

    .welcome-section {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
        margin-bottom: 35px;
    }

    .welcome-title {
        font-size: 32px;
        font-weight: 700;
        margin: 0;
        background: linear-gradient(90deg, #4385ff, #a34bff, #ed4db8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .welcome-text {
        color: var(--muted-color);
        margin-top: 10px;
        font-size: 15px;
    }

    .dashboard-label {
        background: linear-gradient(110deg, #1748D8, #6515C8, #E83DAB);
        color: white;
        padding: 11px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

    /* =========================================
       SECTION HEADINGS
    ========================================= */

    .section-title {
        font-size: 22px;
        font-weight: 700;
        margin: 35px 0 20px;
        color: var(--text-color);
    }

    .section-title span {
        color: var(--accent-color);
    }

    /* =========================================
       DASHBOARD STATISTICS
    ========================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
    }

    .stat-card {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 24px;
        transition: 0.3s;
        position: relative;
        overflow: hidden;
    }

    .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, #1748D8, #6515C8, #E83DAB);
    }

    .stat-card:hover {
        transform: translateY(-5px);
        border-color: var(--accent-color);
        box-shadow: 0 8px 22px rgba(101, 69, 216, 0.2);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1748D8, #6515C8);
        color: white;
        border-radius: 12px;
        font-size: 23px;
        margin-bottom: 18px;
    }

    .stat-label {
        color: var(--muted-color);
        font-size: 14px;
        margin-bottom: 10px;
    }

    .stat-number {
        color: var(--text-color);
        font-size: 32px;
        font-weight: 700;
        margin: 0;
    }

    .stat-description {
        color: var(--muted-color);
        font-size: 12px;
        margin-top: 10px;
    }

    /* =========================================
       QUICK ACTIONS
    ========================================= */

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .action-card {
        display: block;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 23px;
        text-decoration: none;
        color: var(--text-color);
        transition: 0.3s;
    }

    .action-card:hover {
        border-color: var(--accent-color);
        transform: translateY(-4px);
        box-shadow: 0 8px 22px rgba(101, 69, 216, 0.2);
        color: var(--text-color);
    }

    .action-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #1748D8, #6515C8, #E83DAB);
        color: white;
        border-radius: 12px;
        font-size: 23px;
        margin-bottom: 15px;
    }

    .action-title {
        color: var(--text-color);
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .action-description {
        color: var(--muted-color);
        font-size: 13px;
        line-height: 1.6;
        margin-bottom: 15px;
    }

    .action-link {
        color: var(--accent-color);
        font-size: 13px;
        font-weight: 600;
    }

    /* =========================================
       MOVIE LIBRARY
    ========================================= */

    .movies-section {
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 14px;
        padding: 25px;
        margin-top: 20px;
    }

    .movies-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

    .movies-heading {
        color: var(--text-color);
        font-size: 21px;
        font-weight: 700;
        margin: 0;
    }

    .movies-heading span {
        color: var(--accent-color);
    }

    .movie-search {
        background: var(--input-bg);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 11px 14px;
        color: var(--text-color);
        width: 260px;
        max-width: 100%;
        outline: none;
    }

    .movie-search::placeholder {
        color: var(--muted-color);
    }

    .movie-search:focus {
        border-color: var(--accent-color);
        box-shadow: 0 0 8px rgba(101, 69, 216, 0.3);
    }

    .movie-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 20px;
    }

    .movie-card {
        min-width: 0;
        background: var(--page-bg);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden;
        transition: 0.3s;
    }

    .movie-card:hover {
        border-color: var(--accent-color);
        transform: translateY(-4px);
    }

    .movie-poster {
        width: 100%;
        height: 260px;
        object-fit: cover;
        display: block;
        background: var(--card-bg);
    }

    .movie-info {
        padding: 14px;
    }

    .movie-id {
        color: var(--muted-color);
        font-size: 12px;
        margin-bottom: 7px;
    }

    .movie-name {
        color: var(--text-color);
        font-size: 15px;
        font-weight: 600;
        overflow-wrap: anywhere;
        margin: 0;
    }

    /* =========================================
       MOVIE ENABLE / DISABLE
    ========================================= */

    .movie-status {
        font-size: 12px;
        font-weight: 600;
        margin-top: 12px;
        margin-bottom: 12px;
    }

    .status-enabled {
        color: #16a34a;
    }

    .status-disabled {
        color: #dc2626;
    }

    .movie-toggle-btn {
        width: 100%;
        padding: 9px;
        border: none;
        border-radius: 6px;
        color: white;
        font-weight: 600;
        cursor: pointer;
        margin-top: 5px;
    }

    .enable-btn {
        background: #16a34a;
    }

    .disable-btn {
        background: #dc2626;
    }

    .movie-toggle-btn:hover {
        opacity: 0.85;
    }

    .empty-message {
        text-align: center;
        padding: 45px 15px;
        color: var(--muted-color);
        grid-column: 1 / -1;
    }

    .empty-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .no-search-results {
        display: none;
        color: var(--muted-color);
        text-align: center;
        padding: 25px;
    }

    /* =========================================
       RESPONSIVE DESIGN
    ========================================= */

    @@media (max-width: 1000px) {

        .stats-grid,
        .actions-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .movie-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 600px) {

        .admin-container {
            width: 92%;
            margin: 25px auto;
        }

        .welcome-title {
            font-size: 26px;
        }

        .stats-grid,
        .actions-grid {
            grid-template-columns: 1fr;
        }

        .movie-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .movie-poster {
            height: 210px;
        }

        .movies-section {
            padding: 15px;
        }

        .movie-search {
            width: 100%;
            box-sizing: border-box;
        }
    }

</style>


<div class="admin-container">

    <!-- WELCOME SECTION -->

    <div class="welcome-section">

        <div>
            <h1 class="welcome-title">Admin Dashboard</h1>

            <p class="welcome-text">
                Welcome to Book My Ticket. Manage your movies and bookings from here.
            </p>
        </div>

        <div class="dashboard-label">
            &#9881; ADMIN PANEL
        </div>

    </div>


    <!-- DASHBOARD OVERVIEW -->

    <h2 class="section-title">
        Dashboard <span>Overview</span>
    </h2>

    <div class="stats-grid">

        <!-- TOTAL MOVIES -->

        <div class="stat-card">

            <div class="stat-icon">&#127916;</div>

            <div class="stat-label">Total Movies</div>

            <h3 class="stat-number">@Model.TotalMovies</h3>

            <div class="stat-description">
                Movies available in the system
            </div>

        </div>


        <!-- REGISTERED USERS -->

        <div class="stat-card">

            <div class="stat-icon">&#128101;</div>

            <div class="stat-label">Registered Users</div>

            <h3 class="stat-number">@Model.TotalUsers</h3>

            <div class="stat-description">
                All registered accounts
            </div>

        </div>


        <!-- TOTAL BOOKINGS -->

        <div class="stat-card">

            <div class="stat-icon">&#127915;</div>

            <div class="stat-label">Total Bookings</div>

            <h3 class="stat-number">@Model.TotalBookings</h3>

            <div class="stat-description">
                Booking records in the system
            </div>

        </div>


        <!-- PENDING APPROVALS -->

        <div class="stat-card">

            <div class="stat-icon">&#9203;</div>

            <div class="stat-label">Pending Owner Approvals</div>

            <h3 class="stat-number">@Model.PendingOwnerCount</h3>

            <div class="stat-description">
                Theatre owners waiting for approval
            </div>

        </div>


        <!-- APPROVED OWNERS -->

        <div class="stat-card">

            <div class="stat-icon">&#10004;</div>

            <div class="stat-label">Approved Theatre Owners</div>

            <h3 class="stat-number">@Model.ApprovedOwnerCount</h3>

            <div class="stat-description">
                Theatre owners approved by admin
            </div>

        </div>

    </div>


    <!-- QUICK ACTIONS -->

    <h2 class="section-title">
        Quick <span>Actions</span>
    </h2>

    <div class="actions-grid">

        <!-- ADD MOVIE -->

        <a asp-controller="Movie"
           asp-action="Movie_Pageload"
           class="action-card">

            <div class="action-icon">&#10133;</div>

            <div class="action-title">
                Add Movie
            </div>

            <div class="action-description">
                Add a new movie with its poster and details.
            </div>

            <div class="action-link">
                Add Movie &#8594;
            </div>

        </a>


        <!-- THEATRE OWNER APPROVALS -->

        <a asp-controller="Admin"
           asp-action="Pending_TheatreOwners"
           class="action-card">

            <div class="action-icon">&#128100;</div>

            <div class="action-title">
                Theatre Owner Approvals
            </div>

            <div class="action-description">
                View theatre owner requests and manage pending approvals.
            </div>

            <div class="action-link">
                View Requests &#8594;
            </div>

        </a>


        <!-- MANAGE BOOKINGS -->

        <a asp-controller="Booking"
           asp-action="Booking_View"
           class="action-card">

            <div class="action-icon">&#127915;</div>

            <div class="action-title">
                Manage Bookings
            </div>

            <div class="action-description">
                View booking information recorded in the system.
            </div>

            <div class="action-link">
                View Bookings &#8594;
            </div>

        </a>

    </div>


    <!-- MOVIE LIBRARY -->

    <h2 class="section-title">
        Movie <span>Library</span>
    </h2>

    <div class="movies-section">

        <div class="movies-header">

            <h3 class="movies-heading">
                Movies <span>Collection</span>
            </h3>

            <input type="text"
                   id="movieSearch"
                   class="movie-search"
                   placeholder="Search movies..."
                   onkeyup="searchMovies()" />

        </div>


        <div class="movie-grid" id="movieGrid">

            @if (Model.MovieList != null && Model.MovieList.Count > 0)
            {
                @foreach (var movie in Model.MovieList)
                {
                    <div class="movie-card"
                         data-movie-name="@(movie.Movie_Name ?? "")">

                        <img src="@Url.Content("~/MovieImages/" + movie.Movie_Image)"
                             alt="@(movie.Movie_Name ?? "Movie poster")"
                             class="movie-poster"
                             onerror="this.style.display='none';" />

                        <div class="movie-info">

                            <div class="movie-id">
                                Movie ID: @movie.Movie_Id
                            </div>

                            <h4 class="movie-name">
                                @movie.Movie_Name
                            </h4>

                            @if (movie.IsEnable)
                            {
                                <div class="movie-status status-enabled">
                                    Status: Enabled
                                </div>

                                <form asp-controller="Admin"
                                      asp-action="Movie_IsEnable_Update"
                                      method="post">

                                    <input type="hidden"
                                           name="Movie_Id"
                                           value="@movie.Movie_Id" />

                                    <input type="hidden"
                                           name="IsEnable"
                                           value="false" />

                                    <button type="submit"
                                            class="movie-toggle-btn disable-btn">
                                        Disable Movie
                                    </button>

                                </form>
                            }
                            else
                            {
                                <div class="movie-status status-disabled">
                                    Status: Disabled
                                </div>

                                <form asp-controller="Admin"
                                      asp-action="Movie_IsEnable_Update"
                                      method="post">

                                    <input type="hidden"
                                           name="Movie_Id"
                                           value="@movie.Movie_Id" />

                                    <input type="hidden"
                                           name="IsEnable"
                                           value="true" />

                                    <button type="submit"
                                            class="movie-toggle-btn enable-btn">
                                        Enable Movie
                                    </button>

                                </form>
                            }

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="empty-message">

                    <div class="empty-icon">&#127916;</div>

                    <h3>No Movies Available</h3>

                    <p>Add a movie to see it displayed here.</p>

                </div>
            }

        </div>


        <div id="noSearchResults" class="no-search-results">
            No movies match your search.
        </div>

    </div>

</div>


<!-- MOVIE SEARCH SCRIPT -->

<script>

    function searchMovies() {

        var searchText = document.getElementById("movieSearch").value.toLowerCase();

        var movieCards = document.getElementsByClassName("movie-card");

        var visibleCount = 0;

        for (var i = 0; i < movieCards.length; i++) {

            var movieName = movieCards[i].getAttribute("data-movie-name").toLowerCase();

            if (movieName.includes(searchText)) {

                movieCards[i].style.display = "";

                visibleCount++;

            }
            else {

                movieCards[i].style.display = "none";

            }

        }

        var noResults = document.getElementById("noSearchResults");

        if (visibleCount == 0 && movieCards.length > 0) {

            noResults.style.display = "block";

        }
        else {

            noResults.style.display = "none";

        }

    }

</script>
