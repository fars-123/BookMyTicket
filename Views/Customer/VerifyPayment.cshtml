
@{
    Layout = null;
    ViewData["Title"] = "Payment Successful";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        min-height: 100vh;
        font-family: "Segoe UI", Arial, sans-serif;
        background: linear-gradient(135deg, #090914, #17172b);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .payment-card {
        width: 100%;
        max-width: 480px;
        background: #1c1c2e;
        border: 1px solid #34344c;
        border-radius: 24px;
        padding: 38px 28px;
        text-align: center;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
        animation: appear 0.6s ease;
    }

    .brand {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 30px;
    }

        .brand span {
            color: #ff3868;
        }

    .success-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #173f32;
        border: 2px solid #36d99b;
        color: #36d99b;
        font-size: 62px;
        line-height: 92px;
        margin: 0 auto 25px;
        animation: pop 0.5s ease;
    }

    h1 {
        font-size: 29px;
        margin: 0 0 12px;
    }

    .message {
        color: #b9bacd;
        font-size: 15px;
        line-height: 1.7;
        margin-bottom: 24px;
    }

    .status {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 25px;
        background: #173f32;
        color: #5cf0b5;
        font-size: 13px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .divider {
        border: 0;
        border-top: 1px solid #39394c;
        margin-bottom: 25px;
    }

    .ticket-message {
        background: #25253a;
        border-radius: 14px;
        padding: 18px;
        margin-bottom: 25px;
        color: #dedeee;
        font-size: 14px;
        line-height: 1.8;
    }

        .ticket-message strong {
            color: white;
            font-size: 16px;
        }

    .home-button {
        display: block;
        padding: 15px;
        border-radius: 12px;
        background: linear-gradient(90deg, #ff3868, #ff5b48);
        color: white;
        text-decoration: none;
        font-weight: bold;
        font-size: 16px;
        transition: 0.3s;
    }

        .home-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 22px rgba(255, 56, 104, 0.3);
        }

    .secure-text {
        margin-top: 22px;
        color: #85859d;
        font-size: 12px;
        line-height: 1.8;
    }

    @@keyframes appear {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pop {
        0% {
            transform: scale(0.5);
        }

        70% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }
    }
</style>

<div class="payment-card">

    <div class="brand">
        Book<span>My</span>Ticket
    </div>

    <div class="success-icon">✓</div>

    <h1>Payment Successful!</h1>

    <p class="message">
        Your payment has been completed successfully.
        Get ready to enjoy your movie!
    </p>

    <div class="status">
        ✓ PAYMENT CONFIRMED
    </div>

    <hr class="divider" />

    <div class="ticket-message">
        <strong>Your movie experience awaits!</strong>
        <br />
        Thank you for booking with BookMyTicket.
        We hope you enjoy the show.
    </div>

    <a href="@Url.Action("Customer_Pageload", "Customer")"
       class="home-button">
        Explore More Movies
    </a>

    <div class="secure-text">
        🔒 Secure payment verification
        <br />
        BookMyTicket · Your movie, your moment
    </div>

</div>
