@model BookMyTicket.Models.ForgotPassword_Model
<style>
    .login-card {
        width: 100%;
        max-width: 450px;
        margin: 70px auto;
        padding: 40px;
        box-sizing: border-box;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.18);
    }

    .login-title {
        text-align: center;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 25px;
        background: linear-gradient(90deg, #4385FF, #A34BFF, #E83DAB);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .form-group { margin-bottom: 22px; }

    .form-group label {
        display: block;
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 8px;
    }

    .login-input {
        width: 100%;
        height: 48px;
        box-sizing: border-box;
        padding: 12px 14px;
        background: var(--input-bg);
        color: var(--text-color);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 15px;
        outline: none;
    }

    .login-input:focus {
        border-color: #6515C8;
        box-shadow: 0 0 0 3px rgba(101, 21, 200, 0.15);
    }

    .validation-message { color: #E83DAB; font-size: 13px; }

    .login-btn {
        width: 100%;
        height: 49px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #1748D8, #6515C8, #E83DAB);
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .login-message {
        background: rgba(232, 61, 171, 0.12);
        color: #E83DAB;
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
    }

    .back-link { text-align: center; margin-top: 25px; }
    .back-link a { color: #A34BFF; font-weight: bold; text-decoration: none; }
</style>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<partial name="_PasswordStyle" />

<div class="login-card">
    <h2 class="login-title">Forgot Password</h2>

    @if (TempData["msgfp"] != null)
    {
        <div class="login-message">@TempData["msgfp"]</div>
    }

    <form asp-controller="Password" asp-action="ForgotPassword_Click" method="post">
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" class="login-input" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="validation-message"></span>
        </div>

        <button type="submit" class="login-btn">Send Reset Link</button>
    </form>

    <div class="back-link">
        <a asp-controller="Login" asp-action="Login_Pageload">Back to Login</a>
    </div>
</div>