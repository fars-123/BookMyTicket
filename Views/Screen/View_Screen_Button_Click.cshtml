 @model List<BookMyTicket.Models.Screen>

@{
    ViewData["Title"] = "Manage Shows";
}

<style>
    .screen-page {
        width: 94%;
        max-width: 1400px;
        margin: 35px auto;
        color: var(--text-color);
    }

    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 30px;
    }

    .page-heading h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 0;
    }

    .screen-count {
        background: #f5c518;
        color: #111;
        padding: 9px 18px;
        border-radius: 20px;
        font-weight: 700;
    }

    .screen-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 22px;
    }

    .screen-card {
        background: var(--card-bg, #201d17);
        border: 1px solid rgba(245, 197, 24, 0.35);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.15);
    }

    .card-header {
        background: #f5c518;
        color: #111;
        padding: 16px 20px;
    }

    .card-header h3 {
        font-size: 21px;
        font-weight: 700;
        margin: 0;
    }

    .card-body {
        padding: 20px;
    }

    .show-status {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 18px;
    }

    .enabled-status {
        background: #198754;
        color: white;
    }

    .disabled-status {
        background: #dc3545;
        color: white;
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 5px;
        overflow-wrap: anywhere;
    }

    .detail-label {
        font-size: 12px;
        color: var(--text-color);
        opacity: 0.7;
    }

    .detail-value {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-color);
    }

    .card-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 22px;
    }

    .action-btn {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        flex: 1;
        min-width: 110px;
        padding: 10px 12px;
        border-radius: 7px;
        border: none;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }

    .action-btn:hover {
        opacity: 0.85;
        transform: translateY(-2px);
    }

    .view-btn {
        background: #0d6efd;
        color: white;
    }

    .edit-btn {
        background: #f5c518;
        color: #111;
    }

    .delete-btn {
        background: #dc3545;
        color: white;
    }

    .enable-btn {
        background: #198754;
        color: white;
    }

    .disable-btn {
        background: #dc3545;
        color: white;
    }

    .card-actions form {
        flex: 1;
        min-width: 110px;
        margin: 0;
        display: flex;
    }

    .card-actions form button {
        width: 100%;
    }

    .empty-message {
        text-align: center;
        padding: 45px 20px;
        border: 1px dashed #f5c518;
        border-radius: 12px;
        margin-top: 20px;
    }

    .empty-message h3 {
        color: #f5c518;
        margin-bottom: 10px;
    }

    @@media (max-width: 600px) {
        .page-heading h2 {
            font-size: 24px;
        }

        .details-grid {
            grid-template-columns: 1fr 1fr;
        }

        .screen-page {
            width: 96%;
        }
    }
</style>

<div class="screen-page">

    <div class="page-heading">
        <h2>Manage Shows</h2>

        <span class="screen-count">
            Total Shows: @Model.Count
        </span>
    </div>

    @if (TempData["msg"] != null)
    {
        <div class="alert alert-info">
            @TempData["msg"]
        </div>
    }

    @if (Model.Count > 0)
    {
        <div class="screen-grid">

            @foreach (var item in Model)
            {
                <div class="screen-card">

                    <div class="card-header">
                        <h3>@item.ScreenName</h3>
                    </div>

                    <div class="card-body">

                        @if (item.IsEnable)
                        {
                            <span class="show-status enabled-status">
                                Show Enabled
                            </span>
                        }
                        else
                        {
                            <span class="show-status disabled-status">
                                Show Disabled
                            </span>
                        }

                        <div class="details-grid">

                            <div class="detail-item">
                                <span class="detail-label">Show ID</span>
                                <span class="detail-value">@item.Screen_Id</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Movie Name</span>
                                <span class="detail-value">@item.Movie_Name</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Show Date</span>
                                <span class="detail-value">@item.ShowDate.ToString("dd-MM-yyyy")</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Ticket Price</span>
                                <span class="detail-value">₹@item.TicketPrice</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Start Time</span>
                                <span class="detail-value">@item.StartTime</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">End Time</span>
                                <span class="detail-value">@item.EndTime</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Rows</span>
                                <span class="detail-value">@item.Rows</span>
                            </div>

                            <div class="detail-item">
                                <span class="detail-label">Columns</span>
                                <span class="detail-value">@item.Columns</span>
                            </div>

                        </div>

                        <div class="card-actions">

                            <a asp-controller="Customer"
                               asp-action="View_Seats"
                               asp-route-screen_id="@item.Screen_Id"
                               class="action-btn view-btn">
                                View Seats
                            </a>

                            <a asp-controller="Screen"
                               asp-action="Edit_Screen"
                               asp-route-screen_id="@item.Screen_Id"
                               class="action-btn edit-btn">
                                Edit Show
                            </a>

                            @if (item.IsEnable)
                            {
                                <form asp-controller="Screen"
                                      asp-action="Show_IsEnable_Update"
                                      method="post">

                                    <input type="hidden" name="Screen_Id" value="@item.Screen_Id" />
                                    <input type="hidden" name="IsEnable" value="false" />

                                    <button type="submit" class="action-btn disable-btn">
                                        Disable Show
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Screen"
                                      asp-action="Show_IsEnable_Update"
                                      method="post">

                                    <input type="hidden" name="Screen_Id" value="@item.Screen_Id" />
                                    <input type="hidden" name="IsEnable" value="true" />

                                    <button type="submit" class="action-btn enable-btn">
                                        Enable Show
                                    </button>
                                </form>
                            }

                            <a asp-controller="Screen"
                               asp-action="Delete_Screen"
                               asp-route-screen_id="@item.Screen_Id"
                               class="action-btn delete-btn"
                               onclick="return confirm('Are you sure you want to delete this show?');">
                                Delete Show
                            </a>

                        </div>

                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="empty-message">
            <h3>No Shows Available</h3>
            <p>You have not added any shows yet.</p>
        </div>
    }

</div>



