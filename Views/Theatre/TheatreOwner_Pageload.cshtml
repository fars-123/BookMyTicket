
@model BookMyTicket.Models.Screen

@{
    ViewData["Title"] = "Theatre Owner Dashboard";
}

<style>
    .dashboard-container {
        padding: 30px;
        min-height: 100vh;
    }

    .dashboard-heading {
        margin-bottom: 30px;
    }

    .dashboard-heading h1 {
        font-size: 32px;
        font-weight: 700;
        color: var(--text-color);
    }

    .dashboard-heading p {
        color: var(--text-color);
        opacity: 0.7;
    }

    /* DASHBOARD CARDS */

    .dashboard-cards {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 35px;
    }

    .dashboard-card {
        padding: 25px;
        border-radius: 18px;
        color: white;
        box-shadow: 0 5px 20px rgba(0,0,0,0.15);
        transition: 0.3s;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
    }

    .card-one {
        background: linear-gradient(135deg, #4776e6, #8e54e9);
    }

    .card-two {
        background: linear-gradient(135deg, #11998e, #38ef7d);
    }

    .card-three {
        background: linear-gradient(135deg, #8e2de2, #c471ed);
    }

    .card-four {
        background: linear-gradient(135deg, #ee0979, #ff6a00);
    }

    .dashboard-card h3 {
        font-size: 16px;
        font-weight: 500;
        margin-bottom: 15px;
    }

    .dashboard-card h2 {
        font-size: 30px;
        font-weight: 700;
        margin: 0;
    }

    /* QUICK ACTIONS */

    .section-heading {
        font-size: 23px;
        font-weight: 700;
        color: var(--text-color);
        margin-bottom: 20px;
    }

    .action-section {
        margin-bottom: 35px;
    }

    .action-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .action-card {
        padding: 25px;
        border-radius: 16px;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        text-align: center;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .action-card h4 {
        color: var(--text-color);
        font-weight: 700;
        margin-bottom: 12px;
    }

    .action-card p {
        color: var(--text-color);
        opacity: 0.7;
        font-size: 14px;
        min-height: 40px;
    }

    .action-btn {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 8px;
        text-decoration: none;
        color: white;
        background: linear-gradient(135deg, #4776e6, #8e54e9);
        font-weight: 600;
        margin-top: 8px;
    }

    .action-btn:hover {
        color: white;
        opacity: 0.85;
    }

    /* RECENT BOOKINGS */

    .booking-section {
        background: var(--card-bg);
        padding: 25px;
        border-radius: 18px;
        border: 1px solid var(--border-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    }

    .booking-table {
        width: 100%;
        border-collapse: collapse;
        color: var(--text-color);
    }

    .booking-table th {
        background: linear-gradient(135deg, #4776e6, #8e54e9);
        color: white;
        padding: 13px;
        text-align: left;
        white-space: nowrap;
    }

    .booking-table td {
        padding: 13px;
        border-bottom: 1px solid var(--border-color);
    }

    .booking-table tbody tr:hover {
        background: rgba(142, 84, 233, 0.08);
    }

    .status-success {
        color: #20a464;
        font-weight: 700;
    }

    .status-pending {
        color: #e09b18;
        font-weight: 700;
    }

    .no-bookings {
        text-align: center;
        padding: 30px;
        color: var(--text-color);
        opacity: 0.7;
    }

    .table-responsive {
        overflow-x: auto;
    }

    /* RESPONSIVE DESIGN */

    @@media (max-width: 900px) {
        .dashboard-cards {
            grid-template-columns: repeat(2, 1fr);
        }

        .action-cards {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 500px) {
        .dashboard-container {
            padding: 15px;
        }

        .dashboard-cards {
            grid-template-columns: 1fr;
        }

        .dashboard-heading h1 {
            font-size: 25px;
        }
    }
</style>

<div class="dashboard-container">

    <!-- DASHBOARD HEADING -->

    <div class="dashboard-heading">
        <h1>Theatre Owner Dashboard</h1>
        <p>Manage your screens, shows and bookings in one place.</p>
    </div>


    <!-- DASHBOARD STATISTICS -->

    <div class="dashboard-cards">

        <div class="dashboard-card card-one">
            <h3>Total Screens</h3>
            <h2>@Model.TotalScreens</h2>
        </div>

        <div class="dashboard-card card-two">
            <h3>Total Shows</h3>
            <h2>@Model.TotalShows</h2>
        </div>

        <div class="dashboard-card card-three">
            <h3>Total Bookings</h3>
            <h2>@Model.TotalBookings</h2>
        </div>

        <div class="dashboard-card card-four">
            <h3>Total Revenue</h3>
            <h2>₹ @Model.TotalRevenue.ToString("N2")</h2>
        </div>

    </div>


    <!-- QUICK ACTIONS -->

    <div class="action-section">

        <h3 class="section-heading">Manage Your Theatre</h3>

        <div class="action-cards">

            <div class="action-card">
                <h4>Add Screen</h4>
                <p>Add a new screen and schedule a movie show.</p>

                <a asp-controller="Screen"
                   asp-action="Screen_Insert_Pageload"
                   class="action-btn">
                    Add Screen
                </a>
            </div>

            <div class="action-card">
                <h4>Manage Shows</h4>
                <p>View the screens and shows in your theatre.</p>

                <a asp-controller="Screen"
                   asp-action="View_Screen_Button_Click"
                   class="action-btn">
                    Manage Shows
                </a>
            </div>

            <div class="action-card">
                <h4>View Bookings</h4>
                <p>Check customer bookings and payment status.</p>

                <a href="#recent-bookings" class="action-btn">
                    View Bookings
                </a>
            </div>

        </div>

    </div>


    <!-- RECENT BOOKINGS -->

    <div class="booking-section" id="recent-bookings">

        <h3 class="section-heading">Recent Bookings</h3>

        <div class="table-responsive">

            <table class="booking-table">

                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Customer</th>
                        <th>Movie</th>
                        <th>Show Date</th>
                        <th>Show Time</th>
                        <th>Seats</th>
                        <th>Seat Count</th>
                        <th>Amount</th>
                        <th>Payment Status</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Booking_List != null && Model.Booking_List.Count > 0)
                    {
                        @foreach (var booking in Model.Booking_List)
                        {
                            <tr>
                                <td>@booking.Booking_Id</td>

                                <td>@booking.FullName</td>

                                <td>@booking.Movie_Name</td>

                                <td>@booking.ShowDate.ToString("dd MMM yyyy")</td>

                                <td>@booking.StartTime.ToString(@"hh\:mm")</td>

                                <td>@string.Join(", ", booking.Seats ?? new List<string>())</td>

                                <td>@booking.SeatCount</td>

                                <td>₹ @booking.TotalAmount.ToString("N2")</td>

                                <td>
                                    @if (booking.PaymentStatus == "Success")
                                    {
                                        <span class="status-success">Success</span>
                                    }
                                    else
                                    {
                                        <span class="status-pending">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="no-bookings">
                                No bookings available yet.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>
