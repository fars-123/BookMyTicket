@model BookMyTicket.Models.ResetPassword_Model

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .login-card {
        width: 100%;
        max-width: 450px;
        margin: 70px auto;
        padding: 40px;
        box-sizing: border-box;
        background: var(--card-bg);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.18);
    }

    .login-title {
        text-align: center;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 25px;
        background: linear-gradient(90deg, #4385FF, #A34BFF, #E83DAB);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: var(--text-color);
        margin-bottom: 8px;
    }

    .login-input {
        width: 100%;
        height: 48px;
        box-sizing: border-box;
        padding: 12px 14px;
        background: var(--input-bg);
        color: var(--text-color);
        border: 1px solid var(--border-color);
        border-radius: 10px;
        font-size: 15px;
        outline: none;
    }

    .login-input:focus {
        border-color: #6515C8;
        box-shadow: 0 0 0 3px rgba(101, 21, 200, 0.15);
    }

    .login-input[readonly] {
        opacity: 0.7;
    }

    .validation-message {
        color: #E83DAB;
        font-size: 13px;
    }

    .login-btn {
        width: 100%;
        height: 49px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(90deg, #1748D8, #6515C8, #E83DAB);
        color: white;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
    }

    .back-btn {
        display: block;
        width: 100%;
        height: 49px;
        line-height: 49px;
        text-align: center;
        box-sizing: border-box;
        margin-top: 12px;
        border-radius: 10px;
        border: 1px solid var(--border-color);
        color: var(--text-color);
        text-decoration: none;
        font-weight: bold;
    }

    .login-message {
        background: rgba(232, 61, 171, 0.12);
        color: #E83DAB;
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
    }
</style>

<div class="login-card">

    <h2 class="login-title">Change Password</h2>

    @if (TempData["msgfp"] != null)
    {
        <div class="login-message">@TempData["msgfp"]</div>
    }

    <form asp-controller="ChangePassword" asp-action="ChangePassword_Click" method="post">

        <input type="hidden" asp-for="Token" />

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Email" class="login-input" readonly />
        </div>

        <div class="form-group">
            <label>New Password</label>
            <input asp-for="NewPassword" type="password" class="login-input" placeholder="Enter new password" />
            <span asp-validation-for="NewPassword" class="validation-message"></span>
        </div>

        <div class="form-group">
            <label>Confirm Password</label>
            <input asp-for="ConfirmPassword" type="password" class="login-input" placeholder="Re-enter new password" />
            <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
        </div>

        <button type="submit" class="login-btn">Submit</button>

    </form>

    <a asp-controller="Login" asp-action="Login_Pageload" class="back-btn">Back</a>

</div>